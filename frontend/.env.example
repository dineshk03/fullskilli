# ===========================================
# Beeja LMS Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your actual values
# Never commit the actual .env.local file to version control

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API Base URL
# For development: http://localhost:5001
# For production: https://api.yourdomain.com
VITE_REACT_APP_BASE_URL=http://localhost:5001

# Alternative API URL (used in some components)
VITE_APP_BASE_URL=http://localhost:5001

# ===========================================
# OAUTH CONFIGURATION
# ===========================================
# Google OAuth Client ID for Single Sign-On
# Get this from Google Cloud Console (https://console.cloud.google.com/)
# Create OAuth 2.0 Client ID under APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# LinkedIn OAuth Client ID
# Get this from LinkedIn Developers (https://www.linkedin.com/developers/)
# Create an app and get the Client ID
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here

# Facebook App ID
# Get this from Facebook Developers (https://developers.facebook.com/)
# Create an app and get the App ID
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# ===========================================
# SUPABASE CONFIGURATION (OPTIONAL)
# ===========================================
# Supabase is used for direct file uploads as an alternative to AWS S3
# Get these values from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Environment mode (automatically set by Vite)
# VITE_MODE=development

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================
# For production builds, make sure to:
# 1. Set VITE_REACT_APP_BASE_URL to your production API URL
# 2. Configure proper CORS on the backend
# 3. Use HTTPS URLs
# 4. Set up proper environment-specific configurations

# ===========================================
# FEATURE FLAGS (OPTIONAL)
# ===========================================
# You can add feature flags here if needed
# VITE_ENABLE_DEBUG_MODE=false
# VITE_ENABLE_ANALYTICS=true

# ===========================================
# NOTES
# ===========================================
# - All Vite environment variables must be prefixed with VITE_
# - Variables are available in the browser, so don't put sensitive data here
# - Use .env.local for local development overrides
# - Use .env.production for production builds
# - The backend handles all sensitive operations and API keys
VITE_PUBLIC_APP_URL=https://your-production-domain.example
